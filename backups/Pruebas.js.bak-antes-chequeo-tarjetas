    var escrituras = [
      ['webEditarCantidad',      webEditarCantidad],
      ['webAgregarLinea',        webAgregarLinea],
      ['webQuitarLinea',         webQuitarLinea],
      ['webCambiarPrecioMenu',   webCambiarPrecioMenu],
