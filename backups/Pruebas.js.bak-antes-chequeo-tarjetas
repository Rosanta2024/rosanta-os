    // Y que cada uno si pueda la suya, o el candado seria una traba.
    [['chef', 'COCINA'], ['sala', 'BARRA'], ['dueno', 'COCINA'], ['dueno', 'BARRA']].forEach(function (par) {
      if (!EDIT.permisos[par[0]]) return;
