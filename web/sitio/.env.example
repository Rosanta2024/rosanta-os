# Copiar a .env (no se versiona) o pasar como variables al construir.
# Ninguna de estas es secreta, pero NO se escriben llaves privadas aquí.

# API de reservas (mismo contrato que Wix). Hoy Wix; desde el 13-nov la nube.
# PUBLIC_API_BASE=https://www.rosanta.rest/_functions
# PUBLIC_API_BASE=/api/reservas

# Receptor de carritos abandonados (receptor de la nube). Vacío = apagado.
# PUBLIC_CARRITO_URL=/api/carritos

# Clave NUEVA de Google Maps/Places, restringida por dominio rosanta.rest (no la de Wix).
# PUBLIC_GOOGLE_MAPS_KEY=

# Compra de gift cards (Recurrente, cuando esté). Vacío = WhatsApp.
# PUBLIC_GIFTCARD_URL=
