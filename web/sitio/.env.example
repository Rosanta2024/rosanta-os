# Copiar a .env (no se versiona) o pasar como variables al construir.
# Ninguna de estas es secreta, pero NO se escriben llaves privadas aquí.

# API de reservas (mismo contrato que Wix). Hoy Wix; desde el 13-nov la nube.
# PUBLIC_API_BASE=https://www.rosanta.rest/_functions
# PUBLIC_API_BASE=/api/reservas

# Receptor de carritos abandonados (receptor de la nube). Vacío = apagado.
# PUBLIC_CARRITO_URL=/api/carritos

# Clave NUEVA de Google Maps/Places, restringida por dominio rosanta.rest (no la de Wix).
# PUBLIC_GOOGLE_MAPS_KEY=

# Compra de gift cards (Recurrente, cuando esté). Vacío = WhatsApp.
# PUBLIC_GIFTCARD_URL=

# ---- SEGUNDA VUELTA (apagada por defecto; sin esto el build es la copia exacta de Wix) ----
# Se pasan EN LA LÍNEA DE COMANDO (el postbuild de sitemaps y llms.txt no lee .env). Ver src/lib/segunda-vuelta.mjs.
# PUBLIC_SEGUNDA_VUELTA=si          gift card nueva, Rosanta Adventures, blog; menú, sitemaps y llms.txt
# PUBLIC_CONTENIDO_JSON=<archivo>   contenido publicado por la nube (formato 1). Vacío: ../contenido/ejemplo-contenido.json + data/blog-ejemplo.json
# PUBLIC_LISTA_ESPERA=si            "Avísame si se libera una mesa" (POST {API_BASE}/lista-espera)
# PUBLIC_AVISO_ABOGADO_OK=si        quita la marca "PENDIENTE DE REVISIÓN DEL ABOGADO" (solo cuando el abogado apruebe)
# PUBLIC_ADVENTURES_URL=/api/adventures/consulta
