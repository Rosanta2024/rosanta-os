{
  "hosting": {
    "public": "dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/beverages-and-wines",
        "destination": "/full-menu",
        "type": 301
      },
      {
        "source": "/blank",
        "destination": "/preguntas-frecuentes",
        "type": 301
      },
      {
        "source": "/cocktails",
        "destination": "/full-menu",
        "type": 301
      },
      {
        "source": "/english-menu",
        "destination": "/full-menu",
        "type": 301
      },
      {
        "source": "/es/_files/ugd/3de38d_09439677a0a74caab0fbbb9562485334.pdf",
        "destination": "/_files/ugd/3de38d_09439677a0a74caab0fbbb9562485334.pdf",
        "type": 301
      },
      {
        "source": "/es/_files/ugd/3de38d_7f417b2d9c4645d4a39a0b166d7f7e9e.pdf",
        "destination": "/_files/ugd/3de38d_7f417b2d9c4645d4a39a0b166d7f7e9e.pdf",
        "type": 301
      },
      {
        "source": "/es/_files/ugd/3de38d_dde190a54ad14f0f872ff51c5fa26798.pdf",
        "destination": "/_files/ugd/3de38d_dde190a54ad14f0f872ff51c5fa26798.pdf",
        "type": 301
      },
      {
        "source": "/es/blank",
        "destination": "/es/preguntas-frecuentes",
        "type": 301
      },
      {
        "source": "/es/menu",
        "destination": "/es/full-menu",
        "type": 301
      },
      {
        "source": "/es/reservations",
        "destination": "/es/reservas",
        "type": 301
      },
      {
        "source": "/menu",
        "destination": "/full-menu",
        "type": 301
      },
      {
        "source": "/menu-completo",
        "destination": "/full-menu",
        "type": 301
      },
      {
        "source": "/menú-español",
        "destination": "/full-menu",
        "type": 301
      },
      {
        "source": "/men%C3%BA-espa%C3%B1ol",
        "destination": "/full-menu",
        "type": 301
      },
      {
        "source": "/para-empezar",
        "destination": "/full-menu",
        "type": 301
      },
      {
        "source": "/reservations",
        "destination": "/reservas",
        "type": 301
      },
      {
        "source": "/something-stronger",
        "destination": "/full-menu",
        "type": 301
      },
      {
        "source": "/something-to-start-with",
        "destination": "/full-menu",
        "type": 301
      },
      {
        "source": "/spirits-and-liqueurs",
        "destination": "/full-menu",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "rosanta-nube",
          "region": "northamerica-south1"
        }
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300, s-maxage=900"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300, s-maxage=900"
          }
        ]
      },
      {
        "source": "/_astro/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/img/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000"
          }
        ]
      },
      {
        "source": "/fonts/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "source": "/_files/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "/js/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/@(robots.txt|llms.txt)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          },
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          }
        ]
      },
      {
        "source": "/*sitemap.xml",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/api/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ]
  }
}
