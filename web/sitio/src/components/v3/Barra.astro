---
// Barra fija abajo en el teléfono: "Reservar mesa" con la prueba social (★ 4.8 · 453) y WhatsApp.
import { existsSync, readFileSync } from 'node:fs';
import path from 'node:path';
import { textos, RUTAS } from '../../lib/v3.mjs';
import { WHATSAPP } from '../../config.mjs';
const { pagina } = Astro.props;
const l = pagina.idioma === 'es' ? 'es' : 'en';
const T = textos(l);
const f = path.join(process.env.ROSANTA_SITIO_RAIZ || process.cwd(), 'data', 'resenas.json');
const r = existsSync(f) ? JSON.parse(readFileSync(f, 'utf8')) : null;
const msg = encodeURIComponent(l === 'es' ? 'Hola, quiero reservar una mesa en Rosanta.' : 'Hi, I would like to book a table at Rosanta.');
---
<div class="v3-barra" data-v3barra>
  <a class="v3-barra-reservar" href={RUTAS[l].reservar}>
    <span>{T.barra.reservar}</span>
    {r?.promedio && <small><span aria-hidden="true">★</span> {r.promedio.toFixed(1)} · {r.total} {T.barra.resenas}</small>}
  </a>
  <a class="v3-barra-wa" href={`https://wa.me/${WHATSAPP}?text=${msg}`} target="_blank" rel="noopener" aria-label={T.barra.whatsapp}>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3z"/></svg>
  </a>
</div>
