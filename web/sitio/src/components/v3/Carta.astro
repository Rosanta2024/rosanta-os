---
// Carta v3 (estilo Ni-Fu Ni-Fa): pestañas que se deslizan (Para compartir · Del fuego · Del jardín · La barra),
// dos columnas en computadora, nombre en mayúscula, línea punteada hasta el precio y una etiqueta corta debajo.
// Cada pestaña abre con foto o video; los platos con foto real muestran una miniatura que se agranda al tocarla.
// Arriba, los platos nuevos en tarjetas con foto y el video del menú nuevo.
// Sin JavaScript se ven las cuatro categorías una debajo de otra (todo el texto queda en el HTML).
import Video from './Video.astro';
import { textos, carta, CABECERAS, RUTAS } from '../../lib/v3.mjs';

const { pagina } = Astro.props;
const l = pagina.idioma === 'es' ? 'es' : 'en';
const T = textos(l);
const C = T.cartaPagina;
const tabs = carta(l);
const nuevos = tabs.flatMap((p) => p.grupos.flatMap((g) => g.platos.map((x) => ({ ...x, tab: p.id })))).filter((x) => x.nuevo && x.foto);
const slug = (s) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---
<section class="v3-carta-cab" aria-labelledby="v3-carta-t">
  <div class="v3-ancho">
    <p class="v3-etiqueta v3-verde">{C.etiqueta}</p>
    <h1 id="v3-carta-t" class="v3-peskia v3-titulo v3-verde">{C.titulo}</h1>
    <p class="v3-texto">{C.bajada}</p>
  </div>
</section>

<section class="v3-nuevos v3-nuevos-carta" aria-labelledby="v3-nue-t">
  <div class="v3-ancho"><h2 id="v3-nue-t" class="v3-etiqueta v3-lila">{C.nuevos}</h2></div>
  <ul class="v3-carrusel" role="list">
    <li class="v3-tarjeta v3-tarjeta-video"><Video clip={T.nuevos.video} alt={T.nuevos.alt} clase="v3-tarjeta-media" /></li>
    {nuevos.map((x) => (
      <li class="v3-tarjeta">
        <a href={`#plato-${slug(x.nombre)}`} data-v3tab={x.tab}>
          <img class="v3-tarjeta-media" src={`/v3/platos/${x.foto}.webp`} alt={x.nombre} width="720" height="900" loading="lazy" decoding="async" />
          <span class="v3-plato-linea"><span class="v3-plato-nombre">{x.nombre}</span><span class="v3-puntos" aria-hidden="true"></span><span class="v3-plato-precio">{x.precio || x.variantes.split(' · ')[0]}</span></span>
          {x.etiquetas[0] && <span class="v3-plato-etq">{x.etiquetas[0]}</span>}
        </a>
      </li>
    ))}
  </ul>
</section>

<div class="v3-carta" data-v3carta>
  <div class="v3-tabs-caja">
    <div class="v3-tabs" role="tablist" aria-label={C.pestanas} hidden data-v3tabs>
      {tabs.map((t, i) => <button type="button" role="tab" id={`tab-${t.id}`} aria-controls={t.id} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{t.nombre}</button>)}
    </div>
  </div>
  {tabs.map((t) => {
    const cab = CABECERAS[t.id] || {};
    return (
      <section class="v3-panel" id={t.id} role="tabpanel" aria-labelledby={`tab-${t.id}`} data-v3panel>
        <div class="v3-panel-cab">
          {cab.video ? <Video clip={cab.video} clase="v3-panel-media" /> : <img class="v3-panel-media" src={cab.foto} alt="" width="720" height="900" loading="lazy" decoding="async" />}
          <h2 class="v3-peskia v3-panel-t">{t.nombre}</h2>
        </div>
        {t.grupos.map((g, gi) => (
          <div class="v3-grupo">
            {g.categoria && g.categoria !== t.grupos[gi - 1]?.categoria && <p class="v3-etiqueta v3-grupo-cat">{g.categoria}</p>}
            <h3 class="v3-grupo-t">{g.titulo}</h3>
            {g.nota && <p class="v3-grupo-nota">{g.nota}</p>}
            <ul class="v3-platos" role="list">
              {g.platos.map((x) => (
                <li class:list={['v3-plato', { 'con-foto': x.foto }]} id={`plato-${slug(x.nombre)}`}>
                  {x.foto && (
                    <button type="button" class="v3-plato-mini" aria-expanded="false" aria-label={`${C.foto}: ${x.nombre}`} data-v3foto={`/v3/platos/${x.foto}.webp`}>
                      <img src={`/v3/platos/${x.foto}-mini.webp`} alt="" width="160" height="160" loading="lazy" decoding="async" />
                    </button>
                  )}
                  <div class="v3-plato-cuerpo">
                    <p class="v3-plato-linea">
                      <span class="v3-plato-nombre">{x.nombre}</span>
                      <span class="v3-puntos" aria-hidden="true"></span>
                      <span class="v3-plato-precio">{x.precio}</span>
                    </p>
                    {x.variantes && <p class="v3-plato-var">{x.variantes}</p>}
                    {x.desc && <p class="v3-plato-desc">{x.desc}</p>}
                    {(x.nuevo || x.maridaje || x.etiquetas.length > 0) && (
                      <p class="v3-plato-etq">
                        {x.nuevo && <span class="v3-nuevo">{x.nuevo}</span>}
                        {[...(x.maridaje ? [`${C.maridaje}: ${x.maridaje}`] : []), ...x.etiquetas].join(' · ')}
                      </p>
                    )}
                    {x.foto && <img class="v3-plato-foto" src={`/v3/platos/${x.foto}.webp`} alt={x.nombre} width="720" height="900" loading="lazy" decoding="async" hidden />}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    );
  })}
  <p class="v3-ancho v3-carta-nota">{C.nota}</p>
  <p class="v3-ancho v3-acciones v3-carta-fin"><a class="v3-boton v3-boton-verde" href={RUTAS[l].reservar}>{C.reservar}</a></p>
</div>
