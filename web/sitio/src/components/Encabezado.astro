---
// Encabezado: logo, selector EN | ES y el menú. Rediseño del 23-oct (Juanma): 5 pestañas + el botón de
// Reservaciones a la vista (6 en total) y el resto en "Más" / "More" (lista en src/lib/navegacion.mjs).
// En el teléfono el menú se abre con una casilla (CSS) y "Más" es un <details>: funciona sin JavaScript.
import { datos, rutaOtroIdioma } from '../lib/sitio.mjs';
import { NAVEGACION } from '../lib/navegacion.mjs';

const { pagina } = Astro.props;
const idioma = pagina.idioma;
const comun = datos().comun[idioma] || datos().comun.en;
const nav = NAVEGACION[idioma] || NAVEGACION.en;
const buscar = (bloques, t) => {
  for (const b of bloques) {
    if (b.t === t) return b;
    const h = b.hijos && buscar(b.hijos, t);
    if (h) return h;
  }
  return null;
};
const logo = buscar(comun.encabezado, 'svg');
const inicio = idioma === 'es' ? '/es' : '/';
const otra = rutaOtroIdioma(pagina);
const enRuta = idioma === 'en' ? pagina.ruta : otra;
const esRuta = idioma === 'es' ? pagina.ruta : otra;
const actual = (href) => href === pagina.ruta;
---
<header class="encabezado" style={comun.fondo_encabezado ? `background:${comun.fondo_encabezado}` : undefined}>
  <div class="encabezado-in">
    <a class="logo" href={inicio} aria-label="Rosanta" set:html={logo?.svg || 'ROSANTA'} />
    {/* Idioma (Juanma, 23-oct): texto chico con el OTRO idioma, sin pastilla, banderas ni globo. */}
    <a class="idioma-link" href={idioma === 'es' ? enRuta : esRuta} hreflang={idioma === 'es' ? 'en' : 'es'} lang={idioma === 'es' ? 'en' : 'es'}
      data-paridad="ignorar" aria-label={idioma === 'es' ? 'English version' : 'Versión en español'}>{idioma === 'es' ? 'EN' : 'ES'}</a>
    <input type="checkbox" id="menu-abrir" class="menu-abrir" aria-hidden="true" tabindex="-1" />
    <label for="menu-abrir" class="menu-boton" aria-label={idioma === 'es' ? 'Menú' : 'Menu'}><span></span><span></span><span></span></label>
    <nav class="menu" aria-label={idioma === 'es' ? 'Principal' : 'Main'}>
      <ul>
        {nav.principales.map((it) => (
          <li><a href={it.href} aria-current={actual(it.href) ? 'page' : undefined}>{it.texto}</a></li>
        ))}
        <li class="mas">
          <details>
            <summary>{nav.mas.texto}</summary>
            <ul class="sub">
              {nav.mas.items.map((s) => <li><a href={s.href} aria-current={actual(s.href) ? 'page' : undefined}>{s.texto}</a></li>)}
            </ul>
          </details>
        </li>
        <li class="li-idioma" data-paridad="ignorar">
          <a href={esRuta} hreflang="es" lang="es" aria-current={idioma === 'es' ? 'true' : undefined}>ES</a>
          <span aria-hidden="true">·</span>
          <a href={enRuta} hreflang="en" lang="en" aria-current={idioma === 'en' ? 'true' : undefined}>EN</a>
        </li>
        <li class="li-reservar"><a class="reservar" href={nav.reservar.href} aria-current={actual(nav.reservar.href) ? 'page' : undefined}>{nav.reservar.texto}</a></li>
      </ul>
    </nav>
  </div>
  <script is:inline>
    (function(){
      var h=document.currentScript.parentNode, d=h.querySelector('.mas details'), c=h.querySelector('#menu-abrir');
      // "Más" se cierra al hacer clic afuera o con Esc; el menú del teléfono se cierra al elegir una opción.
      document.addEventListener('click',function(e){ if(d&&d.open&&!d.contains(e.target)) d.open=false; });
      document.addEventListener('keydown',function(e){ if(e.key==='Escape'&&d&&d.open){ d.open=false; d.querySelector('summary').focus(); } });
      h.querySelectorAll('.menu a').forEach(function(a){ a.addEventListener('click',function(){ if(c) c.checked=false; if(d) d.open=false; }); });
    })();
  </script>
</header>
