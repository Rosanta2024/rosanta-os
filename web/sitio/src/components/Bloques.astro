---
// Dibuja, en el mismo orden que Wix, los bloques capturados por scripts/extraer.mjs:
// secciones, columnas, textos, botones, imágenes, galerías y componentes.
// Ubicación: Wix pone cada elemento en una grilla (grid-area) con un margen izquierdo y un ancho
// en px sobre 980 px. Aquí se usa la misma grilla en pantallas anchas (clase .malla) y en el
// teléfono todo va apilado a ancho completo.
import Bloques from './Bloques.astro';
import Imagen from './Imagen.astro';
import FormularioReservas from './FormularioReservas.astro';
import FormularioCotizacion from './FormularioCotizacion.astro';
import ResenasGoogle from './ResenasGoogle.astro';
import Faq from './Faq.astro';
import Privacidad from './Privacidad.astro';
import Contacto from './Contacto.astro';
import Destacados from './Destacados.astro';
import { htmlResponsivo, hrefMenu, imagenLocal, altDe, srcsetDe } from '../lib/sitio.mjs';
import { cartaConFotos } from '../lib/carta.mjs';
import { readFileSync } from 'node:fs';
import path from 'node:path';
import { ENCUESTA_URL, GIFTCARD_URL, WHATSAPP } from '../config.mjs';

const { bloques = [], pagina, ref = 980 } = Astro.props;
const fotosPlatos = JSON.parse(readFileSync(path.join(process.env.ROSANTA_SITIO_RAIZ || process.cwd(), 'data', 'fotos-platos.json'), 'utf8'));
const GALERIA_RESERVAS = 'comp-lujxv6ly';
/** Botones con texto que invita a actuar (Juanma, 23-oct). */
const TEXTO_BOTON = {
  'comp-mszgtzji': { es: 'Reserva tu mesa', en: 'Book a table' },
};
const idioma = pagina.idioma;

function imagenesLocales(html) {
  return html.replace(/<img data-medio="([^"]+)" alt="([^"]*)"(?: width="\d+")?(?: height="\d+")?>/g, (_, medio, alt) => {
    const md = medio.replace(/&amp;/g, '&');
    const im = imagenLocal(md);
    if (!im) return '';
    const a = altDe(md, idioma, alt.replace(/&amp;/g, '&')).replace(/&/g, '&amp;').replace(/"/g, '&quot;');
    const ss = srcsetDe(im);
    return `<img src="${im.archivo}"${ss ? ` srcset="${ss}" sizes="(max-width: 999px) 100vw, 980px"` : ''} alt="${a}" width="${im.ancho}" height="${im.alto}" loading="lazy" decoding="async">`;
  });
}
function fondo(b) {
  const st = [];
  if (b.fondo) st.push(`background-color:${b.fondo}`);
  // La foto de fondo ya no va en CSS: es un <img class="fondo-img"> (fotoFondo) con srcset y carga diferida,
  // para que el teléfono baje el tamaño chico y la primera foto (el LCP) se pida de inmediato (23-oct).
  return st;
}
/** Fondo oscuro (el verde de la marca): los botones de adentro van en menta para que se vean (23-oct). */
function oscuro(b) {
  const c = String(b.fondo || '');
  let m = c.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/), v;
  if (m) v = [m[1], m[2], m[3]].map(Number);
  else if ((m = c.match(/^#([0-9a-f]{6})$/i))) v = [0, 2, 4].map((i) => parseInt(m[1].slice(i, i + 2), 16));
  if (!v) return false;
  return (0.2126 * v[0] + 0.7152 * v[1] + 0.0722 * v[2]) / 255 < 0.45;
}
/** Proporción de las fotos de una galería (la más común): todas se ven completas y del mismo tamaño. */
function proporcion(ims) {
  const l = ims.map((i) => imagenLocal(i.medio)).filter(Boolean).map((i) => i.ancho / i.alto).sort((a, b) => a - b);
  return l.length ? (Math.round(l[Math.floor(l.length / 2)] * 1000) / 1000) : 0.75;
}
const r4 = (n) => Math.round(n * 10000) / 10000;
/** Variables CSS con la posición de Wix (las usa .malla > .pos en sitio.css):
 *  --base: ancho de la caja centrada de Wix (calc((100% - base) * 0.5)); --x: "left"; --w: ancho. */
function pos(b, extra = []) {
  const st = [...extra];
  const p = b.pos;
  if (p && p.area) {
    st.push(`--area:${p.area}`);
    if (p.estirar) st.push('--base:100%', '--x:0px', '--w:100%');
    else {
      st.push(p.base ? `--base:${p.base}px` : '--base:100%');
      st.push(`--x:${Math.round((p.x || 0) + (p.ml || 0))}px`);
      st.push(p.w ? `--w:${Math.round(p.w)}px` : '--w:auto');
    }
    // Siempre explícitas: las variables CSS se heredan del contenedor si faltan.
    st.push(`--top:${Math.round(p.top || 0)}px`, `--abajo:${Math.round(p.abajo || 0)}px`);
  }
  return st.length ? st.join(';') : undefined;
}
/** Foto de fondo: <img> que cubre el bloque, con su alt (data/alt.json) y srcset. La del primer bloque de la
 *  página (el hero) se pide primero; las demás, cuando se acercan a la pantalla. */
function fotoFondo(b) {
  if (!b.fondoImg) return '';
  const im = imagenLocal(b.fondoImg.medio);
  if (!im) return '';
  const t = altDe(b.fondoImg.medio, idioma, '').replace(/&/g, '&amp;').replace(/"/g, '&quot;');
  const primero = pagina.bloques?.[0]?.id === b.id;
  const ss = srcsetDe(im);
  return `<img class="fondo-img" src="${im.archivo}"${ss ? ` srcset="${ss}" sizes="${b.t === 'seccion' ? '100vw' : '(max-width: 999px) 100vw, 50vw'}"` : ''} width="${im.ancho}" height="${im.alto}" alt="${t}"${primero ? ' fetchpriority="high"' : ' loading="lazy"'} decoding="async">`;
}
const conPos = (b) => (b.pos && b.pos.area ? 'pos' : null);
const urlGift = GIFTCARD_URL || `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(idioma === 'es' ? 'Hola, quiero comprar una tarjeta de regalo de Rosanta.' : 'Hi, I would like to buy a Rosanta gift card.')}`;
const anchoColumnas = (b) => b.hijos.reduce((s, c) => s + (c.pos?.w || 0), 0) || 980;
---
{bloques.map((b) => {
  switch (b.t) {
    case 'seccion':
      // Contacto y ubicación de la portada: componente propio (Juanma, 23-oct).
      if (b.id === 'comp-lhjc19fq') return <Contacto bloques={b.hijos} pagina={pagina} />;
      return (
        <section id={b.id} class:list={['seccion', { 'con-fondo-img': b.fondoImg, oscura: oscuro(b) }]} style={fondo(b).join(';') || undefined}>
          <Fragment set:html={fotoFondo(b)} />
          <div class="seccion-in malla"><Bloques bloques={b.hijos} pagina={pagina} ref={980} /></div>
        </section>
      );
    case 'columnas': {
      const total = anchoColumnas(b);
      return (
        <div id={b.id} class:list={['columnas', conPos(b), { oscura: oscuro(b) }]} style={pos(b, fondo(b))}>
          {b.hijos.map((c) => (
            <div id={c.id} class:list={['columna', 'malla', { 'con-fondo-img': c.fondoImg, oscura: oscuro(c) }]}
              style={[...fondo(c), `--cw:${r4((c.pos?.w || total / b.hijos.length) / total)}`].join(';')}>
              <Fragment set:html={fotoFondo(c)} />
              <Bloques bloques={c.hijos || []} pagina={pagina} ref={c.pos?.w || 980} />
            </div>
          ))}
          {b.id === 'comp-kybjx46n' && <Destacados idioma={idioma} />}
        </div>
      );
    }
    case 'columna':
      return <div id={b.id} class:list={['columna', 'malla', conPos(b)]} style={pos(b, fondo(b))}><Bloques bloques={b.hijos} pagina={pagina} ref={b.pos?.w || ref} /></div>;
    case 'caja':
    case 'grupo':
      return <div id={b.id} class:list={[b.t, 'malla', conPos(b)]} style={pos(b, fondo(b))}><Bloques bloques={b.hijos} pagina={pagina} ref={b.pos?.w || ref} /></div>;
    case 'rico':
      return <div id={b.id} class:list={['rico', conPos(b)]} style={pos(b)} set:html={htmlResponsivo(imagenesLocales(b.html))} />;
    case 'boton': {
      const href = b.ancla ? hrefMenu({ ancla: b.ancla, href: b.href }, idioma) : b.href;
      // "Request a quote" / "Cotiza tu evento" (/events-1): en Wix no llevaba a ningún lado. Decisión de Juanma (20-oct):
      // baja al formulario de cotización, que va justo debajo del botón.
      if (!href && /request a quote|cotiza tu evento/i.test(String(b.texto || ''))) {
        return <><p class:list={['boton-fila', conPos(b)]} style={pos(b)}><a id={b.id} class="boton" href="#cotizar">{b.texto}</a></p><FormularioCotizacion idioma={idioma} /></>;
      }
      // Sin enlace en Wix: se copia igual, como botón.
      if (!href) return <p class:list={['boton-fila', conPos(b)]} style={pos(b)}><button id={b.id} type="button" class="boton">{b.texto}</button></p>;
      return <p class:list={['boton-fila', conPos(b)]} style={pos(b)}><a id={b.id} class="boton" href={href} {...(b.nueva ? { target: '_blank', rel: 'noopener' } : {})}>{TEXTO_BOTON[b.id]?.[idioma] || b.texto}</a></p>;
    }
    case 'imagen':
      return <div class:list={['imagen-caja', conPos(b)]} style={pos(b)}><Imagen medio={b.medio} alt={b.alt} idioma={idioma} href={b.href} id={b.id} /></div>;
    case 'svg':
      return b.href
        ? <a id={b.id} class:list={['svg', conPos(b)]} style={pos(b)} href={b.href} aria-label={b.etiqueta || undefined} set:html={b.svg} />
        : <div id={b.id} class:list={['svg', conPos(b)]} style={pos(b)} aria-hidden="true" set:html={b.svg} />;
    case 'galeria': {
      // /reservas: las 4 fotos de Wix tenían texto en inglés impreso; van fotos limpias (Juanma, 23-oct).
      const limpias = b.id === GALERIA_RESERVAS ? fotosPlatos.galeria_reservas : null;
      return (
        <div class:list={['galeria-caja', conPos(b)]} style={[pos(b), `--ar:${limpias ? 0.8 : proporcion(b.imagenes)}`].filter(Boolean).join(';')} data-galeria>
          <div id={b.id} class="galeria" role="list" tabindex="0" aria-label={idioma === 'es' ? 'Galería de fotos' : 'Photo gallery'}>
            {limpias
              ? limpias.map((g, i) => <div role="listitem"><figure class="imagen"><img src={`/img/platos/reservas-${i + 1}-400.webp`} srcset={`/img/platos/reservas-${i + 1}-400.webp 400w, /img/platos/reservas-${i + 1}-800.webp 800w`} sizes="(max-width: 640px) 90vw, (max-width: 999px) 45vw, 360px" width="800" height="1000" alt={g.alt[idioma] || g.alt.en} loading="lazy" decoding="async" /></figure></div>)
              : b.imagenes.map((im) => <div role="listitem"><Imagen medio={im.medio} alt={im.alt} idioma={idioma} /></div>)}
          </div>
          <button type="button" class="galeria-flecha galeria-ant" aria-controls={b.id} aria-label={idioma === 'es' ? 'Foto anterior' : 'Previous photo'} hidden>‹</button>
          <button type="button" class="galeria-flecha galeria-sig" aria-controls={b.id} aria-label={idioma === 'es' ? 'Foto siguiente' : 'Next photo'} hidden>›</button>
        </div>
      );
    }
    case 'ancla':
      return <div id={b.id} class="ancla" role="region" aria-label={b.etiqueta || undefined}>{b.etiqueta && <span>{b.etiqueta}</span>}</div>;
    case 'componente': {
      let c = null;
      if (b.nombre === 'formulario-reservas') c = <FormularioReservas idioma={idioma} />;
      else if (b.nombre === 'resenas-google') c = <ResenasGoogle idioma={idioma} />;
      else if (b.nombre === 'faq') c = <Faq idioma={idioma} />;
      else if (b.nombre === 'privacidad') c = <Privacidad idioma={idioma} />;
      else if (/\/encuesta$/.test(pagina.ruta))
        c = <iframe class="encuesta" src={ENCUESTA_URL} title={idioma === 'es' ? 'Encuesta' : 'Survey'} loading="lazy" style={`height:${b.alto || 600}px`}></iframe>;
      return c && <div id={b.id} class:list={['componente', `componente-${b.nombre}`, conPos(b)]} style={pos(b)}>{c}</div>;
    }
    case 'mapa':
      return (
        <div id={b.id} class:list={['mapa-caja', conPos(b)]} style={pos(b)}>
          <iframe class="mapa" title="Rosanta · 1a Calle Oriente 15, Antigua Guatemala" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
            src="https://maps.google.com/maps?q=Rosanta%2C%201a%20Calle%20Oriente%2015%2C%20Antigua%20Guatemala&z=16&output=embed"
            style={`height:${b.alto || 400}px`}></iframe>
        </div>
      );
    case 'widget': {
      const esGift = /gift-card$/.test(pagina.ruta);
      return (
        <div id={b.id} class:list={['widget', { 'widget-gift': esGift, 'visualmente-oculto': b.oculto }, conPos(b)]} style={pos(b)}>
          <Fragment set:html={/full-menu$/.test(pagina.ruta) ? cartaConFotos(imagenesLocales(b.html), idioma) : imagenesLocales(b.html)} />
          {esGift && (
            <p class="boton-fila" data-paridad="mejora"><a class="boton" href={urlGift} target="_blank" rel="noopener">{idioma === 'es' ? 'Comprar' : 'Buy Now'}</a></p>
          )}
        </div>
      );
    }
    case 'redes':
      return <p class="redes">{b.enlaces.map((e) => <a href={e.href} target="_blank" rel="noopener">{e.etiqueta || e.href}</a>)}</p>;
    case 'idioma':
    case 'menu':
      return null;
    default:
      return b.hijos ? <Bloques bloques={b.hijos} pagina={pagina} ref={ref} /> : null;
  }
})}
