---
// Estrellas y reseñas de Google (componente HTML de Wix). Se dibujan en el navegador con la
// API de Places. La clave de Wix NO se copia: GOOGLE_MAPS_KEY (nueva, restringida por dominio).
// Sin clave, queda solo el enlace a las reseñas en Google.
import { GOOGLE_MAPS_KEY, GOOGLE_PLACE_ID } from '../config.mjs';
const { idioma = 'en' } = Astro.props;
const enlace = `https://www.google.com/maps/place/?q=place_id:${GOOGLE_PLACE_ID}`;
const leer = idioma === 'es' ? 'Ver todas las reseñas en Google →' : 'Read all reviews on Google →';
---
<div class="resenas" data-paridad="mejora" data-place={GOOGLE_PLACE_ID}>
  <a class="badge" href={enlace} target="_blank" rel="noopener" hidden>
    <span class="stars"><span class="base">&#9733;&#9733;&#9733;&#9733;&#9733;</span><span class="fill">&#9733;&#9733;&#9733;&#9733;&#9733;</span></span>
    <span class="rating"></span><span class="sep">&middot;</span><span class="count"></span>
    <span>Google reviews</span>
  </a>
  <div class="grid"></div>
  <p class="foot"><a href={enlace} target="_blank" rel="noopener">{leer}</a></p>
</div>
{GOOGLE_MAPS_KEY && (
  <script is:inline define:vars={{ GOOGLE_MAPS_KEY, GOOGLE_PLACE_ID }}>
  (function(){
    var CACHE_KEY='rosanta_resenas_v1',CACHE_MS=24*60*60*1000;
    function esc(s){var d=document.createElement('div');d.textContent=s||'';return d.innerHTML;}
    function starRow(r){r=Math.round(r||0);return '★★★★★'.slice(0,r)+'☆☆☆☆☆'.slice(0,5-r);}
    function paint(d){
      document.querySelectorAll('.resenas').forEach(function(box){
        if(d.rating){var b=box.querySelector('.badge');box.querySelector('.fill').style.width=(d.rating/5*100)+'%';box.querySelector('.rating').textContent=Number(d.rating).toFixed(1);box.querySelector('.count').textContent=d.total?Number(d.total).toLocaleString('en-US'):'';if(d.url)b.href=d.url;b.hidden=false;}
        var grid=box.querySelector('.grid');grid.innerHTML='';
        (d.reviews||[]).slice(0,4).forEach(function(rv){var name=rv.name||'Guest',initial=(name.trim().charAt(0)||'G').toUpperCase();var av=rv.photo?'<div class="av" style="background-image:url('+esc(rv.photo)+')"></div>':'<div class="av">'+esc(initial)+'</div>';var c=document.createElement('div');c.className='card';c.innerHTML='<div class="crow">'+av+'<div><div class="who">'+esc(name)+'</div><div class="when">'+esc(rv.when||'')+'</div></div></div><div class="cstars">'+starRow(rv.rating)+'</div><div class="ctext">'+esc(rv.text||'')+'</div>';grid.appendChild(c);});
      });
    }
    function getCache(){try{var c=JSON.parse(localStorage.getItem(CACHE_KEY));if(c&&Date.now()-c.t<CACHE_MS)return c.d;}catch(e){}return null;}
    function setCache(d){try{localStorage.setItem(CACHE_KEY,JSON.stringify({t:Date.now(),d:d}));}catch(e){}}
    window.initResenas=async function(){try{var r=await google.maps.importLibrary('places');var place=new r.Place({id:GOOGLE_PLACE_ID});await place.fetchFields({fields:['rating','userRatingCount','googleMapsURI','reviews']});var d={rating:place.rating,total:place.userRatingCount,url:place.googleMapsURI,reviews:(place.reviews||[]).map(function(x){return{name:(x.authorAttribution&&x.authorAttribution.displayName)||'Guest',photo:(x.authorAttribution&&x.authorAttribution.photoURI)||'',rating:x.rating,when:x.relativePublishTimeDescription||'',text:(x.text&&x.text.text)||x.text||''};})};setCache(d);paint(d);}catch(e){}};
    var c=getCache(); if(c){paint(c);return;}
    if(window.__resenasCargando)return; window.__resenasCargando=true;
    var s=document.createElement('script');s.async=true;s.src='https://maps.googleapis.com/maps/api/js?key='+encodeURIComponent(GOOGLE_MAPS_KEY)+'&loading=async&libraries=places&callback=initResenas';document.head.appendChild(s);
  })();
  </script>
)}
