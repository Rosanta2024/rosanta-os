---
// Reseñas de Google en la portada (Juanma, 23-oct): calificación general + 4 reseñas reales de 5 estrellas
// + enlace a Google. Salen de data/resenas.json, que scripts/resenas.mjs arma desde la base de la nube
// (las reseñas que rosanta-nube lee de Google Business). Se dibujan al construir: sin JavaScript y sin
// widgets de terceros (la versión anterior pedía la API de Places desde el navegador y, sin clave, no mostraba nada).
import { existsSync, readFileSync } from 'node:fs';
import path from 'node:path';
import { GOOGLE_PLACE_ID } from '../config.mjs';

const { idioma = 'en' } = Astro.props;
const es = idioma === 'es';
const archivo = path.join(process.env.ROSANTA_SITIO_RAIZ || process.cwd(), 'data', 'resenas.json');
const d = existsSync(archivo) ? JSON.parse(readFileSync(archivo, 'utf8')) : null;
const lista = (d?.[idioma] || d?.en || []).slice(0, 4);
const enlace = `https://search.google.com/local/reviews?placeid=${GOOGLE_PLACE_ID}`;
const leer = es ? 'Ver todas las reseñas en Google' : 'Read all reviews on Google';
const fmt = new Intl.DateTimeFormat(es ? 'es-GT' : 'en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const cuando = (f) => { const t = fmt.format(new Date(f + 'T12:00:00Z')); return t.charAt(0).toUpperCase() + t.slice(1); };
const inicial = (n) => (String(n).trim().charAt(0) || 'G').toUpperCase();
const promedio = d?.promedio ? d.promedio.toFixed(1) : null;
const total = d?.total ? d.total.toLocaleString('en-US') : null;
---
<div class="resenas" data-paridad="mejora">
  {promedio && (
    <a class="badge" href={enlace} target="_blank" rel="noopener">
      <span class="stars" aria-hidden="true"><span class="base">★★★★★</span><span class="fill" style={`width:${(d.promedio / 5) * 100}%`}>★★★★★</span></span>
      <span class="rating">{promedio}</span><span class="sep" aria-hidden="true">·</span><span class="count">{total}</span>
      <span>{es ? 'reseñas en Google' : 'Google reviews'}</span>
    </a>
  )}
  {lista.length > 0 && (
    <ul class="grid">
      {lista.map((r) => (
        <li class="card">
          <div class="crow">
            <div class="av" aria-hidden="true">{inicial(r.nombre)}</div>
            <div><p class="who">{r.nombre}</p><p class="when">{cuando(r.fecha)}</p></div>
          </div>
          <p class="cstars" aria-label={es ? '5 de 5 estrellas' : '5 out of 5 stars'}>★★★★★</p>
          <p class="ctext">{r.texto}</p>
          {r.traducida && <p class="trad">{es ? 'Traducida por Google' : 'Translated by Google'}</p>}
        </li>
      ))}
    </ul>
  )}
  <p class="foot"><a href={enlace} target="_blank" rel="noopener">{leer} →</a></p>
</div>
