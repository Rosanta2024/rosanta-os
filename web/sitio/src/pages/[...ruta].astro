---
// Una página por cada dirección publicada en Wix (mismas rutas, incluidas /es/... y las que
// llevan acento). El contenido sale de data/paginas/*.json (capturado de Wix).
import Base from '../layouts/Base.astro';
import Bloques from '../components/Bloques.astro';
import PortadaV3 from '../components/v3/Portada.astro';
import CartaV3 from '../components/v3/Carta.astro';
import Video from '../components/v3/Video.astro';
import { V3 } from '../config.mjs';
import { paginasDelSitio, datos, promoverH1 } from '../lib/sitio.mjs';

export function getStaticPaths() {
  return paginasDelSitio().map((p) => ({
    params: { ruta: p.ruta === '/' ? undefined : p.ruta.slice(1) },
    props: { pagina: p },
  }));
}

const { pagina } = Astro.props;
// Mejora mínima (data/mejoras-seo.json): si Wix no tiene H1, el primer título pasa a H1.
const omitir = datos().mejoras.omitir_bloques || {};
const ocultar = datos().mejoras.ocultar_bloques || {};
const filtrar = (l) =>
  l.filter((b) => !omitir[b.id]).map((b) => ({ ...b, ...(ocultar[b.id] ? { oculto: true } : {}), ...(b.hijos ? { hijos: filtrar(b.hijos) } : {}) }));
let bloques = filtrar(pagina.bloques);
if ((datos().mejoras.promover_h1?.rutas || []).includes(pagina.ruta) && !pagina.h1.length) {
  bloques = structuredClone(bloques);
  let hecho = false;
  const recorrer = (l) => l.forEach((b) => {
    if (hecho) return;
    if (b.t === 'rico' && /<h[2-6][\s>]/.test(b.html)) { b.html = promoverH1(b.html); hecho = true; }
    if (b.hijos) recorrer(b.hijos);
  });
  recorrer(bloques);
}
---
{V3 && (pagina.ruta === '/' || pagina.ruta === '/es') ? (
  <Base pagina={pagina} sobreVideo><PortadaV3 pagina={pagina} /></Base>
) : V3 && /\/full-menu$/.test(pagina.ruta) ? (
  <Base pagina={pagina}><CartaV3 pagina={pagina} /></Base>
) : V3 && /\/reservas$/.test(pagina.ruta) ? (
  <Base pagina={pagina}>
    <div class="v3-con-video">
      <div class="v3-con-video-main"><Bloques bloques={bloques} pagina={pagina} /></div>
      <aside class="v3-con-video-lado">
        <Video clip={pagina.idioma === 'es' ? 'reserva-es' : 'portada'} clase="v3-video-vertical"
          alt={pagina.idioma === 'es' ? 'Video: "Reserva tu mesa". Mesas, platos y la esquina de la Alameda Santa Rosa.' : 'Video: the volcano over Antigua, the entrance, the grill lit and a candlelit table.'} />
      </aside>
    </div>
  </Base>
) : (
  <Base pagina={pagina}>
    <Bloques bloques={bloques} pagina={pagina} />
  </Base>
)}
